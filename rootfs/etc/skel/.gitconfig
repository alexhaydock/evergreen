[user]
	name = Alex Haydock
	email = alex@alexhaydock.co.uk
	signingkey = ~/.ssh/id_ed25519_Git.pub

[commit]
	gpgsign = true
	verbose = true

[core]
	autocrlf = input
	compression = 9
	whitespace = trailing-space

[branch]
	sort = -committerdate

[tag]
	forceSignAnnotated = true
	sort = -version:refname

[column]
	ui = auto

[diff]
	algorithm = histogram

[fetch]
	prune = true

[pull]
	rebase = true

[rebase]
	missingCommitsCheck = warn
	autosquash = true

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[status]
	branch = true
	showStash = true

[maintenance]
	auto = true
	strategy = incremental

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[url "git@github.com:"]
	insteadOf = https://github.com/
	insteadOf = gh:
	insteadOf = github:
[gpg]
	format = ssh
