[Unit]
Description=Arti Tor Proxy

[Container]
Image=ghcr.io/alexhaydock/arti-container:main@sha256:4ae8fbd309c0d9f994272f51885cc058e3aaa14ecb9fa7897ab6103699688d74
PublishPort=127.0.0.1:9150:9150
AutoUpdate=registry

# Ensure container starts automatically
# (we don't need preset files for Quadlets)
[Install]
WantedBy=default.target
