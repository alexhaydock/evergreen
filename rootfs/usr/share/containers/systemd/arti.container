[Unit]
Description=Arti Tor Proxy

[Container]
Image=ghcr.io/alexhaydock/arti-container:main@sha256:c93b87e53e41c8d527c492a9c36cc71d68b3b7b212d803445f4228adb7a0c219
PublishPort=127.0.0.1:9150:9150
AutoUpdate=registry

# Ensure container starts automatically
# (we don't need preset files for Quadlets)
[Install]
WantedBy=default.target
