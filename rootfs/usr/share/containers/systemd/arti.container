[Unit]
Description=Arti Tor Proxy

[Container]
Image=ghcr.io/alexhaydock/arti-container:main@sha256:6903dadaf3744e64eb124341ea88744c8dd0a8d1ddce954a0c1d95aed5b06c3b
PublishPort=127.0.0.1:9150:9150
AutoUpdate=registry

# Ensure container starts automatically
# (we don't need preset files for Quadlets)
[Install]
WantedBy=default.target
