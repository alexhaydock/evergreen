[Unit]
Description=Arti Tor Proxy

[Container]
Image=ghcr.io/alexhaydock/arti-container:main@sha256:528ebebc8faed10646de343f88ed782ca8d387c2943498f57968ee1962f65660
PublishPort=127.0.0.1:9150:9150
AutoUpdate=registry

# Ensure container starts automatically
# (we don't need preset files for Quadlets)
[Install]
WantedBy=default.target
