[Unit]
Description=Arti Tor Proxy

[Container]
Image=ghcr.io/alexhaydock/arti-container:main@sha256:587756436ae710535b471382b39dfae32810f5b6fe735765dfef21a55031f772
PublishPort=127.0.0.1:9150:9150
AutoUpdate=registry

# Ensure container starts automatically
# (we don't need preset files for Quadlets)
[Install]
WantedBy=default.target
