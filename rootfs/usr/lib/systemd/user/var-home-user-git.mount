[Unit]
Description=SSHFS Code Mount
# Wait for network to be fully up before trying to mount
# See: https://systemd.io/NETWORK_ONLINE/
After=network-online.target ssh-tpm-agent.socket
Wants=network-online.target
Requires=ssh-tpm-agent.socket

[Mount]
What=code.infected.systems:/root/git
Where=/var/home/user/git
Type=fuse.sshfs
Options=_netdev,reconnect,ServerAliveInterval=5,ServerAliveCountMax=3,idmap=user,IdentityFile=/var/home/user/.ssh/id_TPM-fw_ecdsa
TimeoutSec=60

[Install]
WantedBy=default.target
